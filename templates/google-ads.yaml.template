# Google Ads API credentials
# Copy this file to ~/.ad-analytics/google-ads.yaml and fill in the values.
# See skills/google-ads/references/setup.md for instructions on obtaining each value.

developer_token: YOUR_DEVELOPER_TOKEN
client_id: YOUR_OAUTH2_CLIENT_ID.apps.googleusercontent.com
client_secret: YOUR_OAUTH2_CLIENT_SECRET
refresh_token: YOUR_REFRESH_TOKEN
use_proto_plus: True

# Optional: add login_customer_id if accessing accounts through a manager (MCC) account
# login_customer_id: YOUR_MANAGER_ACCOUNT_ID
